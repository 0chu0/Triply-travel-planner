# ===== 环境变量模板（纯占位符，可安全入库）=====
# 用法：cp .env.example .env 然后填入自己的真实密钥
# .env 已被 .gitignore 忽略，切勿提交真实密钥

# ===== LLM（阿里云百炼 / DashScope）=====
DASHSCOPE_API_KEY=sk-xxx
# main 档（权衡题：编排 / 预算 / 多约束）。代码默认 qwen3.8-flash
QWEN_MODEL_NAME=qwen3.8-flash
# light 档（选择题：查询改写 / 重排 / 意图分类 / 结构化抽取 / 简单问答）
# 代码默认同样为 qwen3.8-flash（两档统一，见 app/config.py）
# 安全阀：把它设成与 QWEN_MODEL_NAME 相同 = 全量回退到单一档，无需改代码
QWEN_LIGHT_MODEL_NAME=qwen3.8-flash
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MAX_TOKENS=2500

# ===== 可观测 Langfuse（可选）=====
# 留空或保持 xxx 占位时，tracing 自动降级关闭，不影响对话
LANGFUSE_PUBLIC_KEY=pk-lf-xxx
LANGFUSE_SECRET_KEY=sk-lf-xxx
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_TRACING_ENABLED=true
# 仅标签字段：tracing.py 不读取它，实际项目由 public_key 决定
LANGFUSE_PROJECT=zhixing-travel-planer-dev

# ===== 数据库（PostgreSQL + pgvector）=====
# docker-compose.yml 不包含数据库服务，需自行准备（本地可用 bash deploy_db.sh）
# 连接串由以下 POSTGRES_* 自动拼装，无需配置 DATABASE_URL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=travel_planner_db
POSTGRES_USER=travel_user
POSTGRES_PASSWORD=your-password

# ===== MCP / 第三方 API =====
AMAP_API_KEY=xxx                      # 高德（地图 POI/路线；天气服务也复用它）
TAVILY_API_KEY=tvly-xxx               # Tavily 联网搜索
# 以下两个不在 config.Settings 中，由 app/mcp_core/client.py 直接 os.getenv 读取
VARIFLIGHT_API_KEY=sk-xxxx            # VariFlight 航班
AIGOHOTEL_MCP_API=mcp_xxx             # AIGOHOTEL 酒店

# ===== 应用 =====
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

# ===== 访问控制 =====
ALLOW_OPEN_REGISTRATION=true
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me

# ===== Token 配额（应用层限额）=====
# 代码默认值为 200000（config.py:29）；生产 .env 显式覆盖为 3000
DEFAULT_USER_TOKEN_QUOTA=3000
QUOTA_REQUEST_CONTACT=
